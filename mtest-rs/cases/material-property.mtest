// Elasticity, whose Young modulus is a material property generated by
// MFront, evaluated at the temperature, which rises from 293.15 to 600 K
// during the uniaxial tension.
@OutputFilePrecision 14;
@Behaviour<generic> 'src/libBehaviour.so' 'Elasticity';
@MaterialProperty<generic> 'YoungModulus' 'src/libGenericMaterialLaw.so' 'YoungModulusNoParameters';
@MaterialProperty<constant> 'PoissonRatio' 0.3;
@ExternalStateVariable 'Temperature' {0:293.15, 1:600};
@ImposedStrain 'EXX' {0:0, 1:1e-3};
@Times {0, 1 in 5};

// The orthotropic elasticity test behaviour, its material frame turned by
// a quarter about x (the rotation matrix by rows), under a strain along z
// and a shear stress.
@OutputFilePrecision 14;
@Behaviour<generic> 'src/libBehaviour.so' 'OrthotropicElasticity';
@MaterialProperty<constant> 'YoungModulus1' 200e9;
@MaterialProperty<constant> 'YoungModulus2' 100e9;
@MaterialProperty<constant> 'YoungModulus3' 50e9;
@MaterialProperty<constant> 'PoissonRatio12' 0.3;
@MaterialProperty<constant> 'PoissonRatio23' 0.2;
@MaterialProperty<constant> 'PoissonRatio13' 0.25;
@MaterialProperty<constant> 'ShearModulus12' 40e9;
@MaterialProperty<constant> 'ShearModulus23' 30e9;
@MaterialProperty<constant> 'ShearModulus13' 35e9;
@ExternalStateVariable 'Temperature' 293.15;
@RotationMatrix {{1, 0, 0}, {0, 0, -1}, {0, 1, 0}};
@ImposedStrain 'EZZ' {0:0, 1:1e-3};
@ImposedStress 'SXY' {0:0, 1:20e6};
@Times {0, 1 in 5};
